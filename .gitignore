# Editor and OS noise
.DS_Store
*~
*.swp
*.swo

# Never commit private credentials or machine-local state if they are copied in.
home/.ssh/
home/.gnupg/
home/.aws/
home/.azure/
home/.kube/
home/.pki/
home/.npmrc
home/.netrc
home/.git-credentials
home/.config/go/telemetry/

# Shell and application history
home/.*history*
home/.viminfo
home/.vim/undodir/
home/.tmux/plugins/
home/.zcompdump*
home/.lesshst
home/.sqlite_history

# Browser, chat, and Electron runtime state
