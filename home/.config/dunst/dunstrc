[global]
    width = 360
    height = 120
    offset = 14x38
    origin = top-right
    notification_limit = 5

    font = JetBrains Mono 10
    frame_width = 2
    frame_color = "#89b4fa"
    separator_color = frame
    corner_radius = 8

    padding = 12
    horizontal_padding = 12
    text_icon_padding = 0

    background = "#1e1e2e"
    foreground = "#cdd6f4"

    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = true
    ellipsize = middle

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#313244"
    timeout = 4

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 6

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
